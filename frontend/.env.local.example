# Copy to .env.local and fill only with the existing team credentials.
# Never commit the populated .env.local.
TEAM_USER=<existing-team-username>
# Escape every dollar sign in the bcrypt hash as \$ for Next.js dotenv expansion.
TEAM_PASSWORD_HASH=\$2b\$12\$<bcrypt-hash-for-existing-team-password>
TEAM_SESSION_SECRET=<random-secret-with-at-least-32-characters>

# Optional local API target used by Next.js development rewrites.
LOCAL_BACKEND_URL=http://127.0.0.1:8080
