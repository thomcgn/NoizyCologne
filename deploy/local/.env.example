# Lokaler Test-Stack – Vorlage. KEINE echten Secrets eintragen.
# Kopieren: cp deploy/local/.env.example deploy/local/.env
# Danach alle PLATZHALTER durch lokal erzeugte Werte ersetzen. deploy/local/.env
# ist gitignored und darf niemals committet werden.

POSTGRES_DB=noizycologne
POSTGRES_USER=noizy
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD

# Serverseitige Secrets: mindestens 32 Zeichen, je Wert separat und zufällig.
API_TRUST_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32_PLUS_CHARS
API_TRUST_PREVIOUS_SECRET=
AUTH_SERVICE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_32_PLUS_CHARS
TEAM_SESSION_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_32_PLUS_CHARS
FACTORY_RESET_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_32_PLUS_CHARS

TEAM_USER=local
# bcrypt-Hash für ein lokales Testpasswort, z. B. erzeugt mit:
#   cd frontend && node -e "console.log(require('bcryptjs').hashSync('local-test-only', 10))"
# WICHTIG: In dieser Compose-.env muss jedes "$" des Hashs als "$$" geschrieben
# werden, sonst interpoliert Docker Compose die bcrypt-Präfixe weg.
TEAM_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_WITH_DOLLARS_DOUBLED

# Muss eine explizite HTTPS-Origin ohne Pfad sein. Lokal terminiert Caddy
# https://localhost mit einem selbstsignierten Zertifikat (tls internal);
# der direkte http://127.0.0.1:3000-Login bleibt wegen der CSRF-Prüfung gesperrt.
NOIZY_PUBLIC_ORIGIN=https://localhost

# NUR LOKAL ZUM TESTEN: Diese Opt-ins dürfen nie in deploy/server übernommen
# werden. Produktion bleibt fail-closed. Für echtes Posten wären zusätzlich ein
# echter Meta-PoC, ein echtes Token und eine öffentlich erreichbare HTTPS-Basis
# für Beitragsbilder sowie alle Review-Gates erforderlich – davon ist hier nichts
# vorhanden. Ohne Token bleibt das Gateway auch bei enabled=true blockiert.
NOIZY_PUBLISH_ENABLED=false
# Current branch cannot start with this flag true: graphApiInstagramGateway
# requires a RestClient.Builder bean that Spring Boot 4 does not provide.
# Keep false until the backend declares that bean; fail-closed gateway remains.
INSTAGRAM_GATEWAY_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MEDIA_PUBLIC_BASE_URL=
INSTAGRAM_WORKER_ENABLED=false
DISCOVERY_EXTERNAL_CALENDAR_ENABLED=false

# Review-Gates bleiben grundsätzlich false, bis sie fachlich abgenommen sind.
INSTAGRAM_GATE_POST_ORDER_SELECTED=false
INSTAGRAM_GATE_WEEKEND_DAY_BALANCE_REVIEWED=false
INSTAGRAM_GATE_POSTING_PLAN_CURRENT=false
INSTAGRAM_GATE_HANDLES_REVIEWED=false
INSTAGRAM_GATE_CAPTION_STALE_CHECK=false
INSTAGRAM_GATE_ADDITIONAL_WORKFLOW_DEFINED=false

# Externe Kalender benötigen eine echte, öffentliche HTTPS-ICS-/JSON-URL.
# SafeUrls lehnt Loopback/private Hosts und Ports ungleich 443 ab; ein lokaler
# Mock-Feed darf deshalb nicht durch Abschwächen der Prüfung simuliert werden.
# Es wird bewusst keine discovery_sources-Zeile mit einer erfundenen MTC-URL angelegt.
