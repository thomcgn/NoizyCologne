# Copy to .env on the VPS only. Never commit the populated file.
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<long-random-database-password>

# Existing team credentials. The hash is validated only by the frontend server; do not use plaintext here.
TEAM_USER=<team-login-name>
TEAM_PASSWORD_HASH=<caddy-bcrypt-hash>
# Long random value used only to sign HttpOnly team-session cookies.
TEAM_SESSION_SECRET=<long-random-session-secret>
# Separate random secret (>=32 characters), equal in frontend/backend; leave unset to disable factory reset.
FACTORY_RESET_SECRET=<another-long-random-secret>
# Separate server-only Caddy/API key (>=32 characters); deployment creates it once if absent.
# API_TRUST_SECRET=<dedicated-random-internal-key>
# API_TRUST_PREVIOUS_SECRET=<temporary-key-only-during-a-controlled-rotation>
ACME_EMAIL=<certificate-renewal-email>

# Set these to the exact existing Docker volume names after read-only inventory.
POSTGRES_DATA_VOLUME=<postgres-volume-name>
CADDY_DATA_VOLUME=<existing-caddy-data-volume-name>
CADDY_CONFIG_VOLUME=<existing-caddy-config-volume-name>
MEDIA_DATA_VOLUME=<persistent-party-flyer-volume-name>

# Location discovery: Tuesday 09:00 Berlin; no Instagram publishing.
DISCOVERY_ENABLED=true
DISCOVERY_CRON=0 0 9 * * TUE
DISCOVERY_ZONE=Europe/Berlin
# HTTP response body bytes: 64 KiB minimum, 4 MiB hard maximum.
DISCOVERY_MAX_RESPONSE_BYTES=2097152
# Generic external ICS/JSON calendar fallback; no MTC feed URL is assumed.
DISCOVERY_EXTERNAL_CALENDAR_ENABLED=false

# Instagram publishing is NOT enabled. The publishing infrastructure exists but
# is fail-closed. Enabling it requires explicit fachliche Freigabe of all review
# gates AND a passed Meta PoC with the real account; do not set these casually.
# NOIZY_PUBLISH_ENABLED is pinned to false in deploy/server/compose.yaml.
# All entries below are optional placeholders; leave them commented/inactive.
# INSTAGRAM_GATEWAY_ENABLED=false
# INSTAGRAM_GATEWAY_BASE_URL=https://graph.facebook.com/v21.0
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GATEWAY_CONNECT_TIMEOUT_MS=3000
# INSTAGRAM_GATEWAY_READ_TIMEOUT_MS=10000
# INSTAGRAM_GATEWAY_MAX_CONTAINER_POLLS=10
# Public, short-lived HTTPS base URL for post images; empty means no send.
# INSTAGRAM_MEDIA_PUBLIC_BASE_URL=
# Worker needs BOTH INSTAGRAM_WORKER_ENABLED=true and NOIZY_PUBLISH_ENABLED=true.
# INSTAGRAM_WORKER_ENABLED=false
# INSTAGRAM_WORKER_INTERVAL_MS=60000
# INSTAGRAM_WORKER_LEASE_MS=300000
# INSTAGRAM_WORKER_BATCH_SIZE=5
# INSTAGRAM_WORKER_POLL_DELAY_MS=1000
# INSTAGRAM_WORKER_RECONCILIATION_LIMIT=25
# Review-gate approvals; all default to false and need explicit sign-off.
# INSTAGRAM_GATE_POST_ORDER_SELECTED=false
# INSTAGRAM_GATE_WEEKEND_DAY_BALANCE_REVIEWED=false
# INSTAGRAM_GATE_POSTING_PLAN_CURRENT=false
# INSTAGRAM_GATE_HANDLES_REVIEWED=false
# INSTAGRAM_GATE_CAPTION_STALE_CHECK=false
# INSTAGRAM_GATE_ADDITIONAL_WORKFLOW_DEFINED=false

# Persistently opt in only after RAM, sandbox, image and rollback preflight.
DISCOVERY_BROWSER_ENABLED=false
# Keep one dedicated random token >=32 characters; deploy.sh generates it once if enabled and absent.
# BROWSER_WORKER_TOKEN=<dedicated-random-browser-token>
# Optional absolute path; must contain the exact profile supplied with the qualified release.
# BROWSER_SECCOMP_PROFILE=/opt/noizycologne/deploy/server/releases/<qualified-sha>/seccomp_profile.json
# The overlay fixes DISCOVERY_BROWSER_URL=http://browser-gateway:3128/render.

# Generated once by deploy.sh; server-only shared by Caddy, Next and the internal auth store.
# AUTH_SERVICE_SECRET=<32-128 letters, digits, underscore or hyphen>
