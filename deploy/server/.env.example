# Copy to .env on the VPS only. Never commit the populated file.
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<long-random-database-password>

# Existing team credentials. The hash is validated only by the frontend server; do not use plaintext here.
TEAM_USER=<team-login-name>
TEAM_PASSWORD_HASH=<caddy-bcrypt-hash>
# Long random value used only to sign HttpOnly team-session cookies.
TEAM_SESSION_SECRET=<long-random-session-secret>
# Separate random secret (>=32 characters), equal in frontend/backend; leave unset to disable factory reset.
FACTORY_RESET_SECRET=<another-long-random-secret>
ACME_EMAIL=<certificate-renewal-email>

# Set these to the exact existing Docker volume names after read-only inventory.
POSTGRES_DATA_VOLUME=<postgres-volume-name>
CADDY_DATA_VOLUME=<existing-caddy-data-volume-name>
CADDY_CONFIG_VOLUME=<existing-caddy-config-volume-name>
MEDIA_DATA_VOLUME=<persistent-party-flyer-volume-name>

# Location discovery: Tuesday 09:00 Berlin; no Instagram publishing.
DISCOVERY_ENABLED=true
DISCOVERY_CRON=0 0 9 * * TUE
DISCOVERY_ZONE=Europe/Berlin
# HTTP response body bytes: 64 KiB minimum, 4 MiB hard maximum.
DISCOVERY_MAX_RESPONSE_BYTES=2097152

# Persistently opt in only after RAM, sandbox, image and rollback preflight.
DISCOVERY_BROWSER_ENABLED=false
# Keep one dedicated random token >=32 characters; deploy.sh generates it once if enabled and absent.
# BROWSER_WORKER_TOKEN=<dedicated-random-browser-token>
# Optional absolute path; must contain the exact profile supplied with the qualified release.
# BROWSER_SECCOMP_PROFILE=/opt/noizycologne/deploy/server/releases/<qualified-sha>/seccomp_profile.json
# The overlay fixes DISCOVERY_BROWSER_URL=http://browser-gateway:3128/render.
